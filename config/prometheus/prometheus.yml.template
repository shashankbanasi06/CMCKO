global:
  scrape_interval: 5s
  evaluation_interval: 5s
  scrape_timeout: 4s
  external_labels:
    monitor: 'cmcko-central-hub'
    hub_node: 'system-3'

rule_files:
  - 'rules/*.yml'

scrape_configs:
  # Self monitoring for Central Prometheus on System-3
  - job_name: 'prometheus-hub'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          cluster: 'System-3'
          role: 'hub'
          platform: 'windows-wsl'
          cluster_namespace: 'hub-namespace'

  # Spoke Cluster 1: System-1 (macOS + OrbStack k8s)
  # Load generated via Apache JMeter
  - job_name: 'remote-cluster-system-1'
    scrape_interval: 5s
    metrics_path: /metrics
    static_configs:
      - targets: ['100.121.118.12:30090']
        labels:
          cluster: 'System-1'
          cluster_namespace: 'system-1-cluster'
          ip_address: '100.121.118.12'
          role: 'spoke'
          platform: 'macos-orbstack'
          load_generator: 'jmeter'
    metric_relabel_configs:
      - source_labels: [k8s_cluster_name]
        target_label: k8s_cluster
      - source_labels: [service_name]
        target_label: service

  # Spoke Cluster 2: System-2 (Windows + WSL k8s)
  # Load generated via Grafana k6
  - job_name: 'remote-cluster-system-2'
    scrape_interval: 5s
    metrics_path: /metrics
    static_configs:
      - targets: ['100.67.50.8:30090']
        labels:
          cluster: 'System-2'
          cluster_namespace: 'system-2-cluster'
          ip_address: '100.67.50.8'
          role: 'spoke'
          platform: 'windows-wsl'
          load_generator: 'k6'
    metric_relabel_configs:
      - source_labels: [k8s_cluster_name]
        target_label: k8s_cluster
      - source_labels: [service_name]
        target_label: service
